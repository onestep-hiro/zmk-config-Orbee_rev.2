#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <180>;
};

&lt { tapping-term-ms = <180>; };

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        touch_behavior_1: touch1 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey1";
            bindings = <&kp A>;
        };

        touch_behavior_2: touch2 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey2";
            bindings = <&kp B>;
        };

        touch_behavior_3: touch3 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey3";
            bindings = <&mo 1>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        tap_hold_behavior: tap_hold_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_HOLD_BEHAVIOR";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 3 Q             &kp W                  &kp E         &kp R                     &kp T                                          &kp Y  &kp U  &kp I      &kp O    &kp P
&kp A               &lt 5 S                &kp D         &kp F                     &kp G                &none          &none      &kp H  &kp J  &kp K      &kp L    &mt LEFT_CONTROL ENTER
&mt LEFT_SHIFT Z    &kp X                  &kp C         &kp V                     &kp B                &none          &none      &kp N  &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&mt LEFT_SHIFT TAB  &kp LS(LA(LC(LG(M))))  &kp LEFT_ALT  &kp LC(LA(LS(LEFT_WIN)))  &mt LEFT_WIN ESCAPE  &lt 1 SPACE    &kp SPACE  &mo 2                             &kp TAB
            >;

            sensor-bindings = <&inc_dec_kp K_VOLUME_DOWN K_VOLUME_UP>;
        };

        layer_1 {
            bindings = <
&kp N1              &kp N2            &kp N3                    &kp N4                 &kp N5                                   &kp N6            &kp N7             &kp N8     &kp N9         &kp N0
&kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)       &kp LS(LA(LC(LG(O))))  &kp LC(B)              &trans    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL  &kp MINUS      &kp SEMICOLON
&kp LEFT_SHIFT      &none             &none                     &kp LG(LEFT_BRACKET)   &kp LG(RIGHT_BRACKET)  &trans    &trans  &kp EXCLAMATION   &kp GRAVE          &kp SQT    &kp BACKSLASH  &kp RIGHT_SHIFT
&none               &none             &kp LS(LC(LG(NUMBER_4)))  &kp LS(LG(N4))         &none                  &none     &mo 3   &kp LG(SPACE)                                                  &kp C_PLAY_PAUSE
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        layer_2 {
            bindings = <
&kp F1      &kp F2      &kp F3  &kp F4   &kp F5                       &none           &none      &kp F13       &kp LS(LA(LC(LG(L))))  &none
&kp F6      &kp F7      &kp F8  &kp F9   &kp F10    &trans    &trans  &kp LEFT_ARROW  &kp DOWN   &kp UP_ARROW  &kp RIGHT_ARROW        &kp BACKSPACE
&kp LSHIFT  &none       &none   &kp F11  &kp F12    &trans    &trans  &none           &kp LC(A)  &kp LC(E)     &none                  &kp RIGHT_SHIFT
&kp C_PREV  &kp C_NEXT  &trans  &trans   &kp LCTRL  &trans    &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&kp F1       &kp F2          &kp F3      &kp F4        &kp F5                                &kp COLON     &kp KP_N7        &kp KP_N8        &kp KP_N9  &kp KP_EQUAL
&kp F6       &kp F7          &kp F8      &kp F9        &kp F10       &none           &trans  &kp KP_SLASH  &kp KP_N4        &kp KP_N5        &kp KP_N6  &kp KP_ASTERISK
&none        &none           &none       &kp F11       &kp F12       &none           &trans  &kp KP_MINUS  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3  &kp KP_PLUS
&bootloader  &studio_unlock  &bt BT_CLR  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &trans  &kp KP_N0                                                  &kp KP_DOT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&none           &none   &kp LC(LG(N))  &kp LC(LG(C))         &none                                           &kp COLON      &kp KP_N7        &kp KP_N8  &kp KP_N9  &kp KP_EQUAL
&kp LEFT_WIN    &none   &kp LEFT_ALT   &mkp MB1              &mkp MB2               &trans           &trans  &kp KP_DIVIDE  &kp KP_NUMBER_4  &kp KP_N5  &kp KP_N6  &kp KP_MULTIPLY
&kp LEFT_SHIFT  &none   &none          &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &trans           &trans  &kp KP_MINUS   &kp KP_N1        &kp KP_N2  &kp KP_N3  &kp KP_PLUS
&trans          &trans  &trans         &trans                &kp ENTER              &kp BACKSPACE    &none   &kp KP_N0                                             &kp KP_DOT
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
